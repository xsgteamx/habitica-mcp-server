# Habitica: Settings -> API
HABITICA_USER_ID=replace-with-your-user-id
HABITICA_API_TOKEN=replace-with-your-api-token

# Host port used by Docker Compose
PORT=8000

# Use a long random path. Keep the leading slash.
# Example generation: openssl rand -hex 24
MCP_PATH=/mcp-replace-with-a-long-random-value

MCP_LANG=zh-CN
MCP_LOG_LEVEL=info
MCP_STATEFUL=false
MCP_SESSION_TIMEOUT=600000
